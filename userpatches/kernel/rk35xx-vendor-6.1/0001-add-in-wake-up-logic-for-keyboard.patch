From 24f10b534abd6d7110250d16fb43fbdf10df75d5 Mon Sep 17 00:00:00 2001
From: Ben Hoff <hoff.benjamin.k@gmail.com>
Date: Sun, 22 Jun 2025 15:32:39 -0400
Subject: [PATCH] add in wake up logic for keyboard

---
 drivers/usb/gadget/function/f_hid.c | 82 +++++++++++++++++++++++++++--
 drivers/usb/gadget/function/u_hid.h |  1 +
 2 files changed, 80 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/gadget/function/f_hid.c b/drivers/usb/gadget/function/f_hid.c
index 933e17bccfca..b45e05ad08ff 100644
--- a/drivers/usb/gadget/function/f_hid.c
+++ b/drivers/usb/gadget/function/f_hid.c
@@ -10,6 +10,7 @@
 #include <linux/hid.h>
 #include <linux/idr.h>
 #include <linux/cdev.h>
+#include <linux/jiffies.h>
 #include <linux/mutex.h>
 #include <linux/poll.h>
 #include <linux/uaccess.h>
@@ -45,6 +46,9 @@ struct f_hidg {
 	unsigned short			report_desc_length;
 	char				*report_desc;
 	unsigned short			report_length;
+	bool wakeup_enabled;
+	atomic_t wakeup_pending;
+	unsigned long last_wakeup_jiffies;
 	/*
 	 * use_out_ep - if true, the OUT Endpoint (interrupt out method)
 	 *              will be used to receive reports from the host
@@ -79,6 +83,8 @@ struct f_hidg {
 	struct usb_ep			*out_ep;
 };
 
+#define WAKEUP_COOLDOWN_J (msecs_to_jiffies(20UL))
+
 static inline struct f_hidg *func_to_hidg(struct usb_function *f)
 {
 	return container_of(f, struct f_hidg, func);
@@ -427,6 +433,21 @@ static void f_hidg_req_complete(struct usb_ep *ep, struct usb_request *req)
 	wake_up(&hidg->write_queue);
 }
 
+static inline bool hidg_can_remote_wakeup(struct f_hidg *hidg,
+					  struct usb_gadget *gadget)
+{
+	/* 1) user enabled it for this function          */
+	if (!hidg->wakeup_enabled)
+		return false;
+
+	/* 2) host actually enabled DEVICE_REMOTE_WAKEUP */
+	if (!gadget->dev.power.can_wakeup)
+		return false;
+
+	/* 3) we’re really suspended                    */
+	return gadget->state == USB_STATE_SUSPENDED;
+}
+
 static ssize_t f_hidg_write(struct file *file, const char __user *buffer,
 			    size_t count, loff_t *offp)
 {
@@ -434,6 +455,7 @@ static ssize_t f_hidg_write(struct file *file, const char __user *buffer,
 	struct usb_request *req;
 	unsigned long flags;
 	ssize_t status = -ENOMEM;
+	int rc;
 
 	spin_lock_irqsave(&hidg->write_spinlock, flags);
 
@@ -506,9 +528,41 @@ static ssize_t f_hidg_write(struct file *file, const char __user *buffer,
 	status = usb_ep_queue(hidg->in_ep, req, GFP_ATOMIC);
 	if (status < 0)
 		goto release_write_pending;
-	else
-		status = count;
 
+	status = count;
+	struct usb_gadget *gadget = hidg->func.config->cdev->gadget;
+
+	if (hidg_can_remote_wakeup(hidg, gadget)) {
+		/* 1) Still inside cool-down window?  Give the slot back and abort. */
+		if (time_before(jiffies,
+				hidg->last_wakeup_jiffies + WAKEUP_COOLDOWN_J))
+			goto skip_wakeup;
+
+		/* 2) Try to claim the slot; if someone else already did, bail out */
+		if (atomic_cmpxchg(&hidg->wakeup_pending, 0, 1))
+			goto skip_wakeup;
+
+		/* 3) Actually issue the remote-wake-up */
+		rc = usb_gadget_wakeup(gadget);
+		switch (rc) {
+		case 0:
+			/* success → reset our cooldown timer */
+			hidg->last_wakeup_jiffies = jiffies;
+			break;
+		case -EBUSY:
+			/* host busy → give the slot back so we can retry later */
+			atomic_set(&hidg->wakeup_pending, 0);
+			break;
+		default:
+			dev_dbg(&gadget->dev, "remote-wakeup failed (%d)\n",
+				rc);
+			atomic_set(&hidg->wakeup_pending, 0);
+			/* wake failure does NOT turn the write into an error */
+			break;
+		}
+	}
+skip_wakeup:
+out:
 	return status;
 release_write_pending:
 	spin_lock_irqsave(&hidg->write_spinlock, flags);
@@ -517,7 +571,7 @@ static ssize_t f_hidg_write(struct file *file, const char __user *buffer,
 
 	wake_up(&hidg->write_queue);
 
-	return status;
+	goto out;
 }
 
 static __poll_t f_hidg_poll(struct file *file, poll_table *wait)
@@ -769,12 +823,24 @@ static int hidg_setup(struct usb_function *f,
 	return status;
 }
 
+static void hidg_resume(struct usb_function *f)
+{
+	struct f_hidg *hidg = func_to_hidg(f);
+
+	/* Host finished resuming → allow next wake cycle */
+	atomic_set(&hidg->wakeup_pending, 0);
+	hidg->last_wakeup_jiffies = jiffies;
+}
+
 static void hidg_disable(struct usb_function *f)
 {
 	struct f_hidg *hidg = func_to_hidg(f);
 	struct f_hidg_req_list *list, *next;
 	unsigned long flags;
 
+	/* Clear any in‐flight remote-wakeup so we start fresh next time */
+	atomic_set(&hidg->wakeup_pending, 0);
+
 	usb_ep_disable(hidg->in_ep);
 
 	if (hidg->out_ep) {
@@ -946,6 +1012,8 @@ static int hidg_bind(struct usb_configuration *c, struct usb_function *f)
 	/* used only if use_out_ep == 1 */
 	hidg->set_report_buf = NULL;
 
+	if (hidg->wakeup_enabled)
+		c->bmAttributes |= USB_CONFIG_ATT_WAKEUP;
 	/* set descriptor dynamic values */
 	hidg_interface_desc.bInterfaceSubClass = hidg->bInterfaceSubClass;
 	hidg_interface_desc.bInterfaceProtocol = hidg->bInterfaceProtocol;
@@ -1099,6 +1167,7 @@ F_HID_OPT(subclass, 8, 255);
 F_HID_OPT(protocol, 8, 255);
 F_HID_OPT(no_out_endpoint, 8, 1);
 F_HID_OPT(report_length, 16, 65535);
+F_HID_OPT(wakeup_enabled, 8, 1);
 
 static ssize_t f_hid_opts_report_desc_show(struct config_item *item, char *page)
 {
@@ -1161,6 +1230,7 @@ static struct configfs_attribute *hid_attrs[] = {
 	&f_hid_opts_attr_report_length,
 	&f_hid_opts_attr_report_desc,
 	&f_hid_opts_attr_dev,
+	&f_hid_opts_attr_wakeup_enabled,
 	NULL,
 };
 
@@ -1205,6 +1275,7 @@ static struct usb_function_instance *hidg_alloc_inst(void)
 	if (!opts)
 		return ERR_PTR(-ENOMEM);
 	mutex_init(&opts->lock);
+	opts->wakeup_enabled = false;
 	opts->func_inst.free_func_inst = hidg_free_inst;
 	ret = &opts->func_inst;
 
@@ -1299,6 +1370,10 @@ static struct usb_function *hidg_alloc(struct usb_function_instance *fi)
 		}
 	}
 	hidg->use_out_ep = !opts->no_out_endpoint;
+	hidg->wakeup_enabled = opts->wakeup_enabled;
+
+	atomic_set(&hidg->wakeup_pending, 0);
+	hidg->last_wakeup_jiffies = jiffies;
 
 	mutex_unlock(&opts->lock);
 
@@ -1306,6 +1381,7 @@ static struct usb_function *hidg_alloc(struct usb_function_instance *fi)
 	hidg->func.bind    = hidg_bind;
 	hidg->func.unbind  = hidg_unbind;
 	hidg->func.set_alt = hidg_set_alt;
+	hidg->func.resume = hidg_resume;
 	hidg->func.disable = hidg_disable;
 	hidg->func.setup   = hidg_setup;
 	hidg->func.free_func = hidg_free;
diff --git a/drivers/usb/gadget/function/u_hid.h b/drivers/usb/gadget/function/u_hid.h
index 84bb70292855..206c25a9d814 100644
--- a/drivers/usb/gadget/function/u_hid.h
+++ b/drivers/usb/gadget/function/u_hid.h
@@ -26,6 +26,7 @@ struct f_hid_opts {
 	unsigned char			*report_desc;
 	bool				report_desc_alloc;
 
+	bool				wakeup_enabled;
 	/*
 	 * Protect the data form concurrent access by read/write
 	 * and create symlink/remove symlink.
-- 
2.50.0

